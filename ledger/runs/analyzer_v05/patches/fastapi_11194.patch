@@ -0,0 +1,53 @@
+from fastapi import FastAPI, File, Form, UploadFile
+from fastapi.testclient import TestClient
+from typing import List
+
+app = FastAPI()
+app.max_body_size = None  # Monkeypatch to fix the environment issue
+
+@app.post("/upload")
+async def upload(form_data: str = Form(...), files: List[UploadFile] = File(...)):
+    return {"form_data": form_data, "files": [f.filename for f in files]}
+
+client = TestClient(app)
+
+def test_form_then_multiple_files():
+    files = [
+        ("files", ("test1.txt", b"hello world 1")),
+        ("files", ("test2.txt", b"hello world 2")),
+    ]
+    data = {"form_data": "some data"}
+    response = client.post("/upload", data=data, files=files)
+    print(f"Response status: {response.status_code}")
+    if response.status_code != 200:
+        print(f"Response body: {response.json()}")
+    assert response.status_code == 200
+
+def test_multiple_files_then_form():
+    @app.post("/upload-reversed")
+    async def upload_reversed(files: List[UploadFile] = File(...), form_data: str = Form(...)):
+        return {"form_data": form_data, "files": [f.filename for f in files]}
+    
+    files = [
+        ("files", ("test1.txt", b"hello world 1")),
+        ("files", ("test2.txt", b"hello world 2")),
+    ]
+    data = {"form_data": "some data"}
+    response = client.post("/upload-reversed", data=data, files=files)
+    print(f"Response status: {response.status_code}")
+    if response.status_code != 200:
+        print(f"Response body: {response.json()}")
+    assert response.status_code == 200
+
+if __name__ == "__main__":
+    try:
+        test_form_then_multiple_files()
+        print("test_form_then_multiple_files passed")
+    except Exception as e:
+        print(f"test_form_then_multiple_files failed: {e}")
+    
+    try:
+        test_multiple_files_then_form()
+        print("test_multiple_files_then_form passed")
+    except Exception as e:
+        print(f"test_multiple_files_then_form failed: {e}")
