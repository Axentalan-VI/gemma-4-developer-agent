@@ -0,0 +1,93 @@
+from fastapi.dependencies.utils import _extract_form_body, _get_multidict_value
+from fastapi._compat import ModelField
+from starlette.datastructures import FormData
+from pydantic import FieldInfo
+from fastapi import params
+from typing import Any, List, Optional
+from copy import deepcopy
+
+# Mocking ModelField and FieldInfo for the test
+class MockFieldInfo(FieldInfo):
+    def __init__(self, default=None, required=False, alias=None):
+        super().__init__(default=default)
+        self.required = required
+        self.alias = alias or None
+
+def test_get_multidict_value():
+    # Case 1: Field is required and value is missing
+    field = ModelField(
+        name="q",
+        type_=str,
+        field_info=MockFieldInfo(required=True),
+        alias="q"
+    )
+    values = {}
+    assert _get_multidict_value(field, values) is None # Should return None if required but missing? 
+    # Wait, looking at _get_multidict_value:
+    # if value is None ...: if field.required: return (which is None)
+
+    # Case 2: Field is optional, value is missing -> should return default
+    field = ModelField(
+        name="q",
+        type_=str,
+        field_info=MockFieldInfo(default="default_val", required=False),
+        alias="q"
+    )
+    values = {}
+    assert _get_multidict_value(field, values) == "default_val"
+
+    # Case 3: Field is optional, value is empty string -> should return default (None)
+    field = ModelField(
+        name="q",
+        type_=str,
+        field_info=MockFieldInfo(default=None, required=False),
+        alias="q"
+    )
+    # We need to make sure field_info is an instance of params.Form
+    # Let's use actual params.Form
+    from fastapi import params
+    field.field_info = params.Form(default=None)
+    field.required = False
+    
+    values = {"q": ""}
+    assert _get_multidict_value(field, values) is None
+
+def test_extract_form_body():
+    # This is where the bug is.
+    # _extract_form_body iterates over body_fields, calls _get_multidict_value.
+    # If the result is not None, it adds it to values.
+    # Then it iterates over received_body.items() and adds missing keys.
+    
+    from fastapi import params
+    field = ModelField(
+        name="q",
+        type_=str,
+        field_info=params.Form(default=None),
+        alias="q"
+    )
+    field.required = False
+    
+    body_fields = [field]
+    received_body = FormData({"q": ""})
+    
+    # Current behavior:
+    # 1. _get_multidict_value(field, received_body) returns None because value is "" and default is None.
+    # 2. value is None, so it's NOT added to values.
+    # 3. Then it iterates over received_body.items(): "q" is not in values, so values["q"] = "".
+    # 4. Result is {"q": ""}, but it should have been {"q": None} or just not present if we want it to be None.
+    
+    import asyncio
+    result = asyncio.run(_extract_form_body(body_fields, received_body))
+    print(f"Result: {result}")
+    assert result.get("q") is None or "q" not in result
+
+if __name__ == "__main__":
+    try:
+        test_get_multidict_value()
+        print("test_get_multidict_value passed!")
+        test_extract_form_body()
+        print("test_extract_form_body passed!")
+    except Exception as e:
+        print(f"Error: {e}")
+        import traceback
+        traceback.print_exc()
