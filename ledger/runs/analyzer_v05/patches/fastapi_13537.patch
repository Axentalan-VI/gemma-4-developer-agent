+import asyncio
+from typing import List, Dict, Any, Mapping, Union
+from unittest.mock import MagicMock
+
+# Mocking the necessary parts of fastapi and pydantic
+class MockFieldInfo:
+    def __init__(self, default=None, required=False):
+        self.default = default
+        self.required = required
+
+class MockModelField:
+    def __init__(self, name, alias, default=None, required=False, field_info=None, type_=None):
+        self.name = name
+        self.alias = alias
+        self.default = default
+        self.required = required
+        self.field_info = field_info
+        self.type_ = type_
+
+# We need to mock the imports used in fastapi.dependencies.utils
+import fastapi.params as params
+import fastapi.dependencies.utils as utils
+
+# Create a mock for params.Form
+class MockForm(params.Form):
+    pass
+
+async def test_extract_form_body_regression():
+    # Setup
+    field_name = "q"
+    field_alias = "q"
+    default_value = None
+    required = False
+    
+    # Create a field that mimics a FastAPI Form field
+    field_info = MockForm(default=default_value, required=required)
+    field = MockModelField(name=field_name, alias=field_alias, default=default_value, required=required, field_info=field_info, type_=str)
+    
+    body_fields = [field]
+    
+    # received_body is like a MultiDict. We can use a simple dict for this test if _get_multidict_value handles it.
+    # In starlette, FormData is a MultiDict.
+    from starlette.datastructures import FormData
+    received_body = FormData({"q": ""})
+    
+    # Execute
+    result = await utils._extract_form_body(body_fields, received_body)
+    
+    print(f"Result: {result}")
+    
+    # Expected: Since q is "", and default is None, and it's a Form field, 
+    # _get_multidict_value should return None.
+    # Then _extract_form_body should NOT overwrite it with "" from received_body.
+    # So result should be {'q': None} or {} depending on how it's handled.
+    
+    # If the bug is present, result will be {'q': ''}
+    # If fixed, result should be {'q': None} or {}
+    
+    # Let's check if it's ''
+    if result.get("q") == "":
+        print("Bug reproduced: result['q'] is ''")
+        return False
+    else:
+        print("Bug not reproduced or already fixed: result['q'] is", result.get("q"))
+        return True
+
+if __name__ == "__main__":
+    if not asyncio.run(test_extract_form_body_regression()):
+        import sys
+        sys.exit(1)
+    else:
+        print("Test passed!")
+        sys.exit(0)
