@@ -0,0 +1,27 @@
+from fastapi import FastAPI, Form
+from fastapi.testclient import TestClient
+from typing import Optional
+
+app = FastAPI()
+
+@app.post("/test")
+async def test_endpoint(q: Optional[str] = Form(None)):
+    return {"q": q}
+
+client = TestClient(app)
+
+def test_empty_string_form_value():
+    # When q is sent as an empty string, it should be None because the default is None
+    # and _get_multidict_value returns the default for empty strings in Form fields.
+    response = client.post("/test", data={"q": ""})
+    print(f"Response: {response.json()}")
+    assert response.json() == {"q": None}
+
+if __name__ == "__main__":
+    try:
+        test_empty_string_form_value()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        import sys
+        sys.exit(1)
