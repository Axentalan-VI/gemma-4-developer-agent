diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..d92bfba8
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,50 @@
+from fastapi import FastAPI, Depends, HTTPException
+from fastapi.security import APIKeyQuery, HTTPBearer, HTTPBasic
+from fastapi.testclient import TestClient
+from starlette.status import HTTP_401_UNAUTHORIZED, HTTP_403_FORBIDDEN
+
+app = FastAPI()
+
+api_key_scheme = APIKeyQuery(name="api_key")
+http_bearer_scheme = HTTPBearer()
+http_basic_scheme = HTTPBasic()
+
+@app.get("/api-key")
+async def read_api_key(api_key: str = Depends(api_key_scheme)):
+    return {"api_key": api_key}
+
+@app.get("/bearer")
+async def read_bearer(token = Depends(http_bearer_scheme)):
+    return {"token": token}
+
+@app.get("/basic")
+async def read_basic(credentials = Depends(http_basic_scheme)):
+    return {"credentials": credentials}
+
+client = TestClient(app)
+
+def test_api_key():
+    response = client.get("/api-key")
+    print(f"APIKeyQuery: status_code={response.status_code}")
+    assert response.status_code == HTTP_403_FORBIDDEN
+
+def test_bearer():
+    response = client.get("/bearer")
+    print(f"HTTPBearer: status_code={response.status_code}")
+    assert response.status_code == HTTP_403_FORBIDDEN
+
+def test_basic():
+    response = client.get("/basic")
+    print(f"HTTPBasic: status_code={response.status_code}")
+    # HTTPBasic should already be 401 according to the issue description
+    assert response.status_code == HTTP_401_UNAUTHORIZED
+
+if __name__ == "__main__":
+    try:
+        test_api_key()
+        test_bearer()
+        test_basic()
+        print("All tests passed (current behavior confirmed)")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
