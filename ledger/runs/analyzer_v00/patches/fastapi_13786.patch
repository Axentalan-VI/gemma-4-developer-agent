diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..2be1b095
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,64 @@
+
+from fastapi import FastAPI, Depends, HTTPException
+from fastapi.security import APIKeyQuery, HTTPBearer, HTTPDigest, OpenIdConnect
+from fastapi.testclient import TestClient
+from starlette.status import HTTP_401_UNAUTHORIZED, HTTP_403_FORBIDDEN
+
+app = FastAPI()
+
+# APIKeyQuery
+api_key_query = APIKeyQuery(name="api_key")
+@app.get("/api-key-query")
+async def read_api_key_query(api_key: str = Depends(api_key_query)):
+    return {"api_key": api_key}
+
+# HTTPBearer
+http_bearer = HTTPBearer()
+@app.get("/http-bearer")
+async def read_http_bearer(credentials = Depends(http_bearer)):
+    return {"credentials": credentials}
+
+# HTTPDigest
+http_digest = HTTPDigest()
+@app.get("/http-digest")
+async def read_http_digest(credentials = Depends(http_digest)):
+    return {"credentials": credentials}
+
+# OpenIdConnect
+open_id_connect = OpenIdConnect(openIdConnectUrl="https://example.com/.well-known/openid-configuration")
+@app.get("/open-id-connect")
+async def read_open_id_connect(credentials = Depends(open_id_connect)):
+    return {"credentials": credentials}
+
+client = TestClient(app)
+
+def test_api_key_query():
+    response = client.get("/api-key-query")
+    print(f"APIKeyQuery: status_code={response.status_code}")
+    assert response.status_code == HTTP_403_FORBIDDEN
+
+def test_http_bearer():
+    response = client.get("/http-bearer")
+    print(f"HTTPBearer: status_code={response.status_code}")
+    assert response.status_code == HTTP_403_FORBIDDEN
+
+def test_http_digest():
+    response = client.get("/http-digest")
+    print(f"HTTPDigest: status_code={response.status_code}")
+    assert response.status_code == HTTP_403_FORBIDDEN
+
+def test_open_id_connect():
+    response = client.get("/open-id-connect")
+    print(f"OpenIdConnect: status_code={response.status_code}")
+    assert response.status_code == HTTP_403_FORBIDDEN
+
+if __name__ == "__main__":
+    try:
+        test_api_key_query()
+        test_http_bearer()
+        test_http_digest()
+        test_open_id_connect()
+        print("All tests passed (current behavior is 403)")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
