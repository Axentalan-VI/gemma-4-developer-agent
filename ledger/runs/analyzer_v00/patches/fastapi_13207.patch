+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.get("/")
+def read_root():
+    return {"Hello": "World"}
+
+client = TestClient(app)
+
+def test_root():
+    response = client.get("/")
+    print(response.json())
+    return response.status_code == 200
+
+if __name__ == "__main__":
+    if test_root():
+        print("SUCCESS")
+    else:
+        print("FAILURE")
+        exit(1)
