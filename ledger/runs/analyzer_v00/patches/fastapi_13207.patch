new file mode 100644
index 00000000..b2894371
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,47 @@
+from fastapi import FastAPI
+from pydantic import BaseModel, computed_field
+from fastapi.testclient import TestClient
+import json
+
+app = FastAPI(separate_input_output_schemas=False)
+
+class Item(BaseModel):
+    name: str
+    
+    @computed_field
+    @property
+    def description(self) -> str:
+        return f"Description of {self.name}"
+
+@app.get("/item", response_model=Item)
+def read_item():
+    return Item(name="test")
+
+client = TestClient(app)
+
+def test_openapi_schema():
+    response = client.get("/openapi.json")
+    schema = response.json()
+    
+    # Check if Item model is in components/schemas
+    schemas = schema.get("components", {}).get("schemas", {})
+    item_schema = schemas.get("Item")
+    
+    if not item_schema:
+        print("Item schema not found in OpenAPI components")
+        return False
+    
+    properties = item_schema.get("properties", {})
+    if "description" not in properties:
+        print("Computed field 'description' is missing from OpenAPI schema when separate_input_output_schemas=False")
+        return False
+    
+    print("Computed field 'description' is present in OpenAPI schema")
+    return True
+
+if __name__ == "__main__":
+    if test_openapi_schema():
+        print("SUCCESS")
+    else:
+        print("FAILURE")
+        exit(1)
