@@ -0,0 +1,56 @@
+import types
+from fastapi._compat.shared import (
+    field_annotation_is_sequence,
+    field_annotation_is_complex,
+    field_annotation_is_scalar_sequence,
+    is_bytes_or_nonable_bytes_annotation,
+    is_uploadfile_or_nonable_uploadfile_annotation,
+    is_bytes_sequence_annotation,
+    is_uploadfile_sequence_annotation,
+    annotation_is_pydantic_v1,
+    is_typealiastype,
+    unwrap_type_aliases,
+)
+from pydantic import BaseModel
+from starlette.datastructures import UploadFile
+from typing import List, Union, Annotated
+
+# PEP 695 Type Aliases
+type MyList = list[int]
+type MyComplex = list[BaseModel]
+type MyScalarSequence = list[int]
+type MyBytes = bytes
+type MyUploadFile = UploadFile
+type MyBytesSeq = list[bytes]
+type MyUploadFileSeq = list[UploadFile]
+
+class MyModel(BaseModel):
+    x: int
+
+type MyPydanticV1Model = MyModel
+
+def test():
+    print(f"MyList type: {type(MyList)}")
+    print(f"MyList is_typealiastype: {is_typealiastype(MyList)}")
+    print(f"MyList unwrapped: {unwrap_type_aliases(MyList)}")
+    print(f"MyList unwrapped type: {type(unwrap_type_aliases(MyList))}")
+    
+    print(f"MyList is sequence: {field_annotation_is_sequence(MyList)} (Expected: True)")
+    print(f"MyComplex is complex: {field_annotation_is_complex(MyComplex)} (Expected: True)")
+    print(f"MyScalarSequence is scalar sequence: {field_annotation_is_scalar_sequence(MyScalarSequence)} (Expected: True)")
+    print(f"MyBytes is bytes: {is_bytes_or_nonable_bytes_annotation(MyBytes)} (Expected: True)")
+    print(f"MyUploadFile is uploadfile: {is_uploadfile_or_nonable_uploadfile_annotation(MyUploadFile)} (Expected: True)")
+    print(f"MyBytesSeq is bytes sequence: {is_bytes_sequence_annotation(MyBytesSeq)} (Expected: True)")
+    print(f"MyUploadFileSeq is uploadfile sequence: {is_uploadfile_sequence_annotation(MyUploadFileSeq)} (Expected: True)")
+
+    try:
+        from pydantic import v1 as pydantic_v1
+        class V1Model(pydantic_v1.BaseModel):
+            x: int
+        type V1Alias = V1Model
+        print(f"V1Alias is pydantic v1: {annotation_is_pydantic_v1(V1Alias)} (Expected: True)")
+    except ImportError:
+        print("Pydantic V1 not available for testing")
+
+if __name__ == "__main__":
+    test()
