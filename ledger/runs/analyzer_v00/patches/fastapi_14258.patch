+from fastapi import APIRouter, FastAPI
+import pytest
+
+def test_circular_router():
+    app = FastAPI()
+    router_a = APIRouter()
+    router_b = APIRouter()
+
+    router_a.include_router(router_b)
+    try:
+        router_b.include_router(router_a)
+        print("Circular reference NOT detected")
+    except Exception as e:
+        print(f"Circular reference detected: {e}")
+
+if __name__ == "__main__":
+    test_circular_router()
