diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..0a03ce96
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,27 @@
+from fastapi import FastAPI, Form
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.post("/test")
+async def test_endpoint(value: str = Form(...)):
+    return {"value": value}
+
+client = TestClient(app)
+
+def test_empty_string_form():
+    # This should return {"value": ""} but currently returns 422 Unprocessable Entity
+    # because it's treated as missing and the field is required.
+    response = client.post("/test", data={"value": ""})
+    print(f"Response: {response.status_code} {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"value": ""}
+
+if __name__ == "__main__":
+    try:
+        test_empty_string_form()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import sys
+        sys.exit(1)
