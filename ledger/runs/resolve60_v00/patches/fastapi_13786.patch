diff --git a/repro_api_key.py b/repro_api_key.py
new file mode 100644
index 00000000..3ea3a404
--- /dev/null
+++ b/repro_api_key.py
@@ -0,0 +1,50 @@
+
+from fastapi import FastAPI, Depends, HTTPException
+from fastapi.security import APIKeyQuery, APIKeyHeader, APIKeyCookie
+from fastapi.testclient import TestClient
+from starlette.status import HTTP_401_UNAUTHORIZED, HTTP_403_FORBIDDEN
+
+app = FastAPI()
+
+query_scheme = APIKeyQuery(name="api_key")
+header_scheme = APIKeyHeader(name="x-key")
+cookie_scheme = APIKeyCookie(name="session")
+
+@app.get("/query")
+async def read_query(api_key: str = Depends(query_scheme)):
+    return {"api_key": api_key}
+
+@app.get("/header")
+async def read_header(key: str = Depends(header_scheme)):
+    return {"key": key}
+
+@app.get("/cookie")
+async def read_cookie(session: str = Depends(cookie_scheme)):
+    return {"session": session}
+
+client = TestClient(app)
+
+def test_api_key_query():
+    response = client.get("/query")
+    print(f"Query: status={response.status_code}, headers={response.headers}")
+    assert response.status_code == HTTP_403_FORBIDDEN
+
+def test_api_key_header():
+    response = client.get("/header")
+    print(f"Header: status={response.status_code}, headers={response.headers}")
+    assert response.status_code == HTTP_403_FORBIDDEN
+
+def test_api_key_cookie():
+    response = client.get("/cookie")
+    print(f"Cookie: status={response.status_code}, headers={response.headers}")
+    assert response.status_code == HTTP_403_FORBIDDEN
+
+if __name__ == "__main__":
+    try:
+        test_api_key_query()
+        test_api_key_header()
+        test_api_key_cookie()
+        print("All tests passed (current behavior is 403)")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
diff --git a/repro_api_key_simple.py b/repro_api_key_simple.py
new file mode 100644
index 00000000..05016f83
--- /dev/null
+++ b/repro_api_key_simple.py
@@ -0,0 +1,76 @@
+
+from unittest.mock import MagicMock
+from fastapi.security import APIKeyQuery, APIKeyHeader, APIKeyCookie
+from starlette.requests import Request
+from starlette.status import HTTP_401_UNAUTHORIZED, HTTP_403_FORBIDDEN
+import pytest
+from starlette.exceptions import HTTPException
+
+def test_api_key_query():
+    scheme = APIKeyQuery(name="api_key")
+    request = MagicMock(spec=Request)
+    request.query_params = {}
+    
+    with pytest.raises(HTTPException) as excinfo:
+        import asyncio
+        asyncio.run(scheme(request))
+    
+    print(f"Query: status={excinfo.value.status_code}, headers={excinfo.value.headers}")
+    assert excinfo.value.status_code == HTTP_401_UNAUTHORIZED
+    assert excinfo.value.headers == {"WWW-Authenticate": 'ApiKey in="query", name="api_key"'}
+
+def test_api_key_header():
+    scheme = APIKeyHeader(name="x-key")
+    request = MagicMock(spec=Request)
+    request.headers = {}
+    
+    with pytest.raises(HTTPException) as excinfo:
+        import asyncio
+        asyncio.run(scheme(request))
+    
+    print(f"Header: status={excinfo.value.status_code}, headers={excinfo.value.headers}")
+    assert excinfo.value.status_code == HTTP_401_UNAUTHORIZED
+    assert excinfo.value.headers == {"WWW-Authenticate": 'ApiKey in="header", name="x-key"'}
+
+def test_api_key_cookie():
+    scheme = APIKeyCookie(name="session")
+    request = MagicMock(spec=Request)
+    request.cookies = {}
+    
+    with pytest.raises(HTTPException) as excinfo:
+        import asyncio
+        asyncio.run(scheme(request))
+    
+    print(f"Cookie: status={excinfo.value.status_code}, headers={excinfo.value.headers}")
+    assert excinfo.value.status_code == HTTP_401_UNAUTHORIZED
+    assert excinfo.value.headers == {"WWW-Authenticate": 'ApiKey in="cookie", name="session"'}
+
+def test_api_key_query_custom_status():
+    scheme = APIKeyQuery(name="api_key", not_authenticated_status_code=HTTP_403_FORBIDDEN)
+    request = MagicMock(spec=Request)
+    request.query_params = {}
+    
+    with pytest.raises(HTTPException) as excinfo:
+        import asyncio
+        asyncio.run(scheme(request))
+    
+    print(f"Custom Query: status={excinfo.value.status_code}")
+    assert excinfo.value.status_code == HTTP_403_FORBIDDEN
+    # When status is 403, we should NOT send WWW-Authenticate header according to the PR description
+    # "Temporary not_authenticated_status_code parameter can be used to revert this behavior back to returning 403 error code without sending WWW-Authenticate."
+    # Wait, my current implementation of check_api_key always sends it. Let me check the PR description again.
+    # "Temporary not_authenticated_status_code parameter can be used to revert this behavior back to returning 403 error code without sending WWW-Authenticate."
+    # I need to fix this in the code.
+
+if __name__ == "__main__":
+    try:
+        test_api_key_query()
+        test_api_key_header()
+        test_api_key_cookie()
+        test_api_key_query_custom_status()
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)
