@@ -0,0 +1,39 @@
+from fastapi import FastAPI, Body
+from fastapi.testclient import TestClient
+from typing import Annotated, Union, Literal
+from pydantic import BaseModel, Discriminator
+
+class Cat(BaseModel):
+    pet_type: Literal["cat"]
+    meow: bool
+
+class Dog(BaseModel):
+    pet_type: Literal["dog"]
+    bark: bool
+
+Pet = Annotated[Union[Cat, Dog], Discriminator("pet_type")]
+
+app = FastAPI()
+
+@app.post("/pet")
+async def create_pet(pet: Pet):
+    return pet
+
+client = TestClient(app)
+
+def test_tagged_union_body():
+    # This should be a request body
+    response = client.post("/pet", json={"pet_type": "cat", "meow": True})
+    print(f"Status code: {response.status_code}")
+    print(f"Response body: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"pet_type": "cat", "meow": True}
+
+if __name__ == "__main__":
+    try:
+        test_tagged_union_body()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
