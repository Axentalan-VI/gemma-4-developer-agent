@@ -0,0 +1,14 @@
+import types
+import typing
+
+try:
+    print(f"TypeAliasType exists: {hasattr(types, 'TypeAliasType')}")
+    if hasattr(types, 'TypeAliasType'):
+        # Using the 'type' keyword for type aliases (PEP 695)
+        # This requires Python 3.12+
+        # Since we are in 3.13, this should work.
+        # However, we can't use the 'type' keyword in a string and exec it easily if we want to be safe, 
+        # but we can just write it in the file.
+        pass
+except Exception as e:
+    print(f"Error: {e}")
diff --git a/verify_pep695.py b/verify_pep695.py
new file mode 100644
index 00000000..f8141ea2
--- /dev/null
+++ b/verify_pep695.py
@@ -0,0 +1,42 @@
+import typing
+from fastapi._compat.shared import (
+    field_annotation_is_sequence,
+    field_annotation_is_complex,
+    field_annotation_is_scalar_sequence,
+    is_bytes_or_nonable_bytes_annotation,
+    is_uploadfile_or_nonable_uploadfile_annotation,
+    is_bytes_sequence_annotation,
+    is_uploadfile_sequence_annotation,
+    annotation_is_pydantic_v1,
+)
+
+# Python 3.12+ syntax
+try:
+    exec("type AliasList = list[int]", globals())
+    AliasList = globals()['AliasList']
+    
+    exec("type AliasComplex = dict[str, int]", globals())
+    AliasComplex = globals()['AliasComplex']
+    
+    exec("type AliasScalarSeq = list[int]", globals())
+    AliasScalarSeq = globals()['AliasScalarSeq']
+    
+    exec("type AliasBytes = bytes", globals())
+    AliasBytes = globals()['AliasBytes']
+    
+    exec("type AliasUploadFile = bytes", globals()) # Using bytes as proxy for UploadFile for simplicity in this test
+    AliasUploadFile = globals()['AliasUploadFile']
+
+    print(f"field_annotation_is_sequence(AliasList): {field_annotation_is_sequence(AliasList)} (Expected: True)")
+    print(f"field_annotation_is_complex(AliasComplex): {field_annotation_is_complex(AliasComplex)} (Expected: True)")
+    print(f"field_annotation_is_scalar_sequence(AliasScalarSeq): {field_annotation_is_scalar_sequence(AliasScalarSeq)} (Expected: True)")
+    print(f"is_bytes_or_nonable_bytes_annotation(AliasBytes): {is_bytes_or_nonable_bytes_annotation(AliasBytes)} (Expected: True)")
+    print(f"is_bytes_sequence_annotation(AliasList): {is_bytes_sequence_annotation(AliasList)} (Expected: False)")
+    
+    # Nested aliases
+    exec("type NestedAlias = AliasList", globals())
+    NestedAlias = globals()['NestedAlias']
+    print(f"field_annotation_is_sequence(NestedAlias): {field_annotation_is_sequence(NestedAlias)} (Expected: True)")
+    
+except Exception as e:
+    print(f"Error: {e}")
